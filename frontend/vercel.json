{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hotel-application-project.onrender.com*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://hotel-application-project.onrender.com"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}