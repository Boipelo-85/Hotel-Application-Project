# Copy to .env for local development. Keep real secrets out of source control.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://hotel_app:replace-me@localhost:5432/hotel_app
OTP_PEPPER=replace-with-a-random-secret-at-least-32-characters-long
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters-long
APP_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=720
OTP_TTL_MINUTES=10

# Administrator setup (for seeding admin user)
ADMIN_EMAIL=admin@example.com
ADMIN_LOGIN_PASSWORD=AdminPassword123!

# SMTP is required for email-code sign-in; no email is sent without this setup.
# If SMTP is not configured, users can still use OAuth (Google/Facebook) for authentication.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Paystack hosted checkout (use a test secret key while developing; never expose it in frontend code)
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback

# Google OAuth (required - for Google sign-in)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5173/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:5173/api/v1/auth/google/callback

# Facebook OAuth (optional - for Facebook sign-in)
# Get credentials from: https://developers.facebook.com/apps
# Valid OAuth Redirect URIs: http://localhost:5173/api/v1/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5173/api/v1/auth/facebook/callback
